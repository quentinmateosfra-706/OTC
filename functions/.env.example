# ============================================================
#  Cloud Functions OTC — Variables d'environnement SECRÈTES
#  Ces variables ne vont JAMAIS dans le code ou dans le .env client.
#
#  Comment les configurer (Firebase CLI) :
#    firebase functions:secrets:set STRAVA_CLIENT_ID
#    firebase functions:secrets:set STRAVA_CLIENT_SECRET
#    firebase functions:secrets:set TOKEN_ENCRYPTION_KEY
#
#  Ou via Google Cloud Secret Manager (recommandé en production).
#  Pour le dev local (émulateurs) : copier dans functions/.env
# ============================================================

# --- Strava (developers.strava.com → ton app → "My API Application") ---
STRAVA_CLIENT_ID=TODO            # même valeur que EXPO_PUBLIC_STRAVA_CLIENT_ID
STRAVA_CLIENT_SECRET=TODO        # SECRET — ne jamais mettre côté client

# --- Stripe (dashboard.stripe.com > Développeurs > Clés API) ---
STRIPE_SECRET_KEY=sk_test_TODO       # SECRET — ne jamais mettre côté client
STRIPE_WEBHOOK_SECRET=whsec_TODO     # Webhook > Signing secret
STRIPE_PRICE_MONTHLY=price_TODO      # ID du prix mensuel créé dans Stripe
STRIPE_PRICE_ANNUAL=price_TODO       # ID du prix annuel créé dans Stripe

# --- RevenueCat ---
REVENUECAT_WEBHOOK_SECRET=TODO       # Dashboard RC > Webhooks > Secret

# --- Chiffrement des tokens (AES-256 = 32 octets = 64 caractères hex) ---
# Génère une clé aléatoire :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=TODO_64_HEX_CHARS
