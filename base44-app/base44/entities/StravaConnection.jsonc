{
  "name": "StravaConnection",
  "type": "object",
  "properties": {
    "athlete_id": {
      "type": "string",
      "description": "Identifiant Strava de l'athl\u00e8te"
    },
    "athlete_name": {
      "type": "string",
      "description": "Nom d'utilisateur Strava"
    },
    "access_token": {
      "type": "string",
      "description": "Token d'acc\u00e8s Strava (chiffr\u00e9 c\u00f4t\u00e9 serveur)"
    },
    "refresh_token": {
      "type": "string",
      "description": "Token de rafra\u00eechissement Strava"
    },
    "expires_at": {
      "type": "number",
      "description": "Timestamp d'expiration du token d'acc\u00e8s"
    },
    "scope": {
      "type": "string",
      "description": "P\u00e9rim\u00e8tre OAuth accord\u00e9"
    }
  },
  "required": [
    "athlete_id",
    "access_token",
    "refresh_token",
    "expires_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}