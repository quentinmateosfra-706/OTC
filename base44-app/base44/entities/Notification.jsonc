{
  "name": "Notification",
  "properties": {
    "body": {
      "description": "Message",
      "type": "string"
    },
    "kind": {
      "description": "Type de notification",
      "enum": [
        "attempt_validated",
        "info"
      ],
      "type": "string"
    },
    "link": {
      "description": "Lien interne (ex. /classement)",
      "type": "string"
    },
    "read": {
      "description": "Lue par le destinataire",
      "type": "boolean"
    },
    "recipient_id": {
      "description": "ID utilisateur du destinataire",
      "type": "string"
    },
    "title": {
      "description": "Titre court",
      "type": "string"
    }
  },
  "required": [
    "recipient_id",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}