# ============================================================
#  OTC — Variables d'environnement (à copier dans un fichier .env)
#  AUCUNE de ces clés n'est secrète côté client SAUF indication.
#  Les vrais secrets (Strava client_secret, clés de paiement) vivent
#  UNIQUEMENT côté Cloud Functions, jamais ici.
# ============================================================

# --- Firebase (récupéré dans la console Firebase > Paramètres du projet) ---
EXPO_PUBLIC_FIREBASE_API_KEY=TODO
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=TODO
EXPO_PUBLIC_FIREBASE_PROJECT_ID=TODO
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=TODO
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=TODO
EXPO_PUBLIC_FIREBASE_APP_ID=TODO

# --- Strava (developers.strava.com) — SEUL le client_id est côté client ---
EXPO_PUBLIC_STRAVA_CLIENT_ID=TODO

# --- Mapbox (compte Mapbox > Access tokens) ---
# Token PUBLIC (affiché dans l'app, préfixe pk.*) :
EXPO_PUBLIC_MAPBOX_TOKEN=TODO
# Token SECRET pour le téléchargement SDK natif au moment du build EAS
# (préfixe sk.* — à mettre dans app.json > plugins > @rnmapbox/maps)
# NE PAS le committer — à injecter via secret EAS ou variable CI.

# --- RevenueCat (clé publique d'API iOS) ---
EXPO_PUBLIC_REVENUECAT_IOS_KEY=TODO
